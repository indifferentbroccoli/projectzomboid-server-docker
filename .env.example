# User Settings
PUID=1000
PGID=1000

# Memory Settings (in GB)
MEMORY_XMX_GB=8
MEMORY_XMS_GB=

VM_ARGS=

# Experimental linux/arm64 settings. Leave PZ_EMULATOR empty to select Box64
# automatically only when the container userspace is ARM64.
PZ_EMULATOR=
ARM64_JVM_PROFILE=compatibility
ARM64_VM_ARGS=
BOX64_DYNAREC_STRONGMEM=3
BOX64_DYNAREC_SAFEFLAGS=2
BOX64_DYNAREC_ALIGNED_ATOMICS=1
BOX64_DYNAREC_BIGBLOCK=0
BOX64_DYNAREC_CALLRET=0
BOX64_JVM=0
BOX64_SSE42=0
BOX64_MAXCPU=4

# Important Please Change!
RCON_PASSWORD=CHANGEME
ADMIN_USERNAME=CHANGEME
ADMIN_PASSWORD=CHANGEME

# Server Settings
UPDATE_ON_START=true
SERVER_BRANCH=
SERVER_NAME=pzserver
DEFAULT_PORT=16261
UDP_PORT=16262
RCON_PORT=27015
MAX_PLAYERS=32
STEAM_VAC=true
USE_STEAM=true
